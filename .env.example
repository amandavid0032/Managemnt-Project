# Root environment for docker-compose. Copy to .env — never commit .env.
#
# Generate secrets with:  openssl rand -hex 32

POSTGRES_USER=eduhub
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_DB=eduhub_dev
POSTGRES_PORT=5432

API_PORT=4000
NODE_ENV=development

JWT_ACCESS_SECRET=CHANGE_ME_GENERATE_A_RANDOM_32_BYTE_HEX_STRING
JWT_ACCESS_TTL=15m
REFRESH_TOKEN_TTL_DAYS=30

CORS_ORIGINS=http://localhost:3000
LOG_LEVEL=info

# --- Email (Phase 2: password reset + email verification) -------------------
# Public URL of the web app; links in emails point here.
APP_URL=http://localhost:3000
#   console — prints each email (with its link) to the API log. Development only.
#   smtp    — real delivery. Required in production (the API refuses to boot
#             otherwise). Works with any provider's SMTP relay: SES, Postmark,
#             SendGrid, Resend, Mailgun...
#   memory  — test suite only.
MAIL_PROVIDER=console
MAIL_FROM="EduHub <no-reply@example.com>"
# Only read when MAIL_PROVIDER=smtp. Put real credentials in the deployment's
# secret store, never in a committed file.
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_SECURE=false        # true for port 465 (TLS from the first byte)
# SMTP_USER=
# SMTP_PASSWORD=
