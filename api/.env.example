# Copy to .env and fill in real values. NEVER commit .env.
NODE_ENV=development
PORT=4000
API_PREFIX=api

# PostgreSQL connection string
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/eduhub_dev?schema=public"

# Prisma WIPES this database every time it diffs or generates a migration.
# It MUST be a throwaway database — never your dev or test database.
SHADOW_DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/eduhub_shadow?schema=public"

# Must be >= 32 characters. Generate with: openssl rand -hex 32
JWT_ACCESS_SECRET=CHANGE_ME_GENERATE_A_RANDOM_32_BYTE_HEX_STRING
JWT_ACCESS_TTL=15m
REFRESH_TOKEN_TTL_DAYS=30

# Comma-separated list of allowed browser origins
CORS_ORIGINS=http://localhost:3000

# Must remain true in production - the config schema enforces it.
THROTTLE_ENABLED=true
THROTTLE_TTL_SECONDS=60
THROTTLE_LIMIT=120

LOG_LEVEL=info
