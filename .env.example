# Root environment for docker-compose. Copy to .env — never commit .env.
#
# Generate secrets with:  openssl rand -hex 32

POSTGRES_USER=eduhub
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_DB=eduhub_dev
POSTGRES_PORT=5432

API_PORT=4000
NODE_ENV=development

JWT_ACCESS_SECRET=CHANGE_ME_GENERATE_A_RANDOM_32_BYTE_HEX_STRING
JWT_ACCESS_TTL=15m
REFRESH_TOKEN_TTL_DAYS=30

CORS_ORIGINS=http://localhost:3000
LOG_LEVEL=info
