# Copy to .env and fill in real values. NEVER commit .env.
NODE_ENV=development
PORT=4000
API_PREFIX=api

# PostgreSQL connection string
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/eduhub_dev?schema=public"

# Prisma WIPES this database every time it diffs or generates a migration.
# It MUST be a throwaway database — never your dev or test database.
SHADOW_DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/eduhub_shadow?schema=public"

# Must be >= 32 characters. Generate with: openssl rand -hex 32
JWT_ACCESS_SECRET=CHANGE_ME_GENERATE_A_RANDOM_32_BYTE_HEX_STRING
JWT_ACCESS_TTL=15m
REFRESH_TOKEN_TTL_DAYS=30

# Comma-separated list of allowed browser origins
CORS_ORIGINS=http://localhost:3000

# Must remain true in production - the config schema enforces it.
THROTTLE_ENABLED=true
THROTTLE_TTL_SECONDS=60
THROTTLE_LIMIT=120

LOG_LEVEL=info

# --- Email (Phase 2: password reset + email verification) -------------------
# Public URL of the web app; links in emails point here.
APP_URL=http://localhost:3000
#   console — prints each email (with its link) to the API log. Development only.
#   smtp    — real delivery. Required in production (the API refuses to boot
#             otherwise). Works with any provider's SMTP relay: SES, Postmark,
#             SendGrid, Resend, Mailgun...
#   memory  — test suite only.
MAIL_PROVIDER=console
MAIL_FROM="EduHub <no-reply@example.com>"
# Only read when MAIL_PROVIDER=smtp. Put real credentials in the deployment's
# secret store, never in a committed file.
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_SECURE=false        # true for port 465 (TLS from the first byte)
# SMTP_USER=
# SMTP_PASSWORD=

# Used ONLY by `npm run create:superadmin` — the API itself never reads these.
# Leave them unset in a committed file; pass them on the command line instead:
#   SUPER_ADMIN_EMAIL=you@example.com SUPER_ADMIN_PASSWORD='...' npm run create:superadmin
# Password rules match the register endpoint: >=12 chars, upper + lower + digit.
# SUPER_ADMIN_EMAIL=
# SUPER_ADMIN_PASSWORD=
# SUPER_ADMIN_NAME=
